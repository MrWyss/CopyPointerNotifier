  <!-- Hook XAML compilation into the native C++ build before ClCompile -->
  <PropertyGroup>
    <BeforeClCompileTargets>$(BeforeClCompileTargets);_RunXamlMarkupCompile;_AddXamlGeneratedSources</BeforeClCompileTargets>
    <MarkupCompilePass2DependsOn>ResolveAssemblyReferences;$(MarkupCompilePass2DependsOn)</MarkupCompilePass2DependsOn>
  </PropertyGroup>
  <!-- Provide WinMD references for XAML compiler Pass2 (native projects without ApplicationType=Windows Store) -->
  <Target Name="_PopulateWinMDReferences" BeforeTargets="MarkupCompilePass2">
    <ItemGroup>
      <WinMDReferenceToCompile Include="@(ReferencePath)" Condition="'%(ReferencePath.WinMDFile)' == 'true'" />
      <WinMDReferenceToCompile Include="$(OutDir)$(RootNamespace).winmd" Condition="Exists('$(OutDir)$(RootNamespace).winmd')" />
    </ItemGroup>
  </Target>
  <Target Name="_RunXamlMarkupCompile"
          DependsOnTargets="MarkupCompilePass1;MarkupCompilePass2"
          Condition="'@(Page)' != '' Or '@(ApplicationDefinition)' != ''" />
  <!-- Add XAML-generated .cpp files to compilation -->
  <Target Name="_AddXamlGeneratedSources">
    <ItemGroup>
      <ClCompile Include="$(IntDir)XamlTypeInfo.g.cpp" Condition="Exists('$(IntDir)XamlTypeInfo.g.cpp')">
        <PrecompiledHeader>NotUsing</PrecompiledHeader>
        <ForcedIncludeFiles>pch.h;MainWindow.xaml.h;MainPage.xaml.h</ForcedIncludeFiles>
      </ClCompile>
      <ClCompile Include="$(IntDir)XamlTypeInfo.Impl.g.cpp" Condition="Exists('$(IntDir)XamlTypeInfo.Impl.g.cpp')">
        <PrecompiledHeader>NotUsing</PrecompiledHeader>
        <ForcedIncludeFiles>pch.h</ForcedIncludeFiles>
      </ClCompile>
      <ClCompile Include="$(IntDir)XamlLibMetadataProvider.g.cpp" Condition="Exists('$(IntDir)XamlLibMetadataProvider.g.cpp')">
        <PrecompiledHeader>NotUsing</PrecompiledHeader>
        <ForcedIncludeFiles>pch.h</ForcedIncludeFiles>
      </ClCompile>
      <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" Condition="Exists('$(GeneratedFilesDir)module.g.cpp')">
        <PrecompiledHeader>Use</PrecompiledHeader>
      </ClCompile>
      <ClCompile Include="$(GeneratedFilesDir)XamlMetaDataProvider.g.cpp" Condition="Exists('$(GeneratedFilesDir)XamlMetaDataProvider.g.cpp')">
        <PrecompiledHeader>NotUsing</PrecompiledHeader>
        <ForcedIncludeFiles>pch.h;XamlMetaDataProvider.h</ForcedIncludeFiles>
        <AdditionalIncludeDirectories>$(GeneratedFilesDir);$(IntDir);$(SolutionDir)packages\Microsoft.Windows.ImplementationLibrary.1.0.240803.1\include;$(MSBuildProjectDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      </ClCompile>
    </ItemGroup>
  </Target>

  <!-- Generate resources.pri after build -->
  <Target Name="_GenerateResourcesPri" AfterTargets="Link">
    <PropertyGroup>
      <_MakePriExe>$([MSBuild]::NormalizePath('$(WindowsSdkDir)\bin\$(WindowsTargetPlatformVersion)\x64\MakePri.exe'))</_MakePriExe>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)Strings\en-US" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Strings\en-US\Resources.resw"
          DestinationFolder="$(OutDir)Strings\en-US" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(Content)"
          DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" />
    <Exec Command="&quot;$(_MakePriExe)&quot; createconfig /cf &quot;$(OutDir)priconfig.xml&quot; /dq en-US /o"
          Condition="Exists('$(_MakePriExe)')" />
    <Delete Files="$(OutDir)resources.pri" />
    <Exec Command="&quot;$(_MakePriExe)&quot; new /pr &quot;$(OutDir).&quot; /cf &quot;$(OutDir)priconfig.xml&quot; /of &quot;$(OutDir)resources.pri&quot; /o"
          Condition="Exists('$(_MakePriExe)')" />
    <Delete Files="$(OutDir)priconfig.xml" />
  </Target>
